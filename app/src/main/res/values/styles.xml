<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F8F3E7</item>
        <item name="android:navigationBarColor">#F8F3E7</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#738F75</item>
    </style>

    <style name="SplashTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F8F2E4</item>
        <item name="android:navigationBarColor">#F8F2E4</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
