<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="12dp" android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/capybara_mascot" android:contentDescription="@string/app_name"/>
        <TextView android:id="@+id/widget_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:text="BaraPause" android:textSize="17sp"
            android:textStyle="bold" android:textColor="#382F27" android:paddingStart="6dp"/>
        <TextView android:id="@+id/widget_target" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:maxLines="1"
            android:text="App" android:textSize="11sp" android:textColor="#526E4C"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_search" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:gravity="center_vertical"
            android:paddingStart="16dp" android:layout_marginEnd="7dp"
            android:background="@drawable/widget_pill" android:textColor="#3B4E35"
            android:textSize="14sp" android:text="🔎 Search"/>
        <TextView android:id="@+id/widget_choose" android:layout_width="45dp"
            android:layout_height="42dp" android:gravity="center"
            android:background="@drawable/widget_pill" android:text="▦" android:textSize="21sp"
            android:textColor="#3B4E35" android:layout_marginEnd="7dp"/>
        <TextView android:id="@+id/widget_open" android:layout_width="45dp"
            android:layout_height="42dp" android:gravity="center"
            android:background="@drawable/widget_pill" android:text="▶" android:textSize="20sp"
            android:textColor="#3B4E35"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_search_label"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Tap search to type keywords" android:textSize="11sp"
        android:textColor="#766F63"/>
</LinearLayout>